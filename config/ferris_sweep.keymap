#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define LOWER 1
#define NAV 2
#define ADJUST 3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <500>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER NAV>;
            then-layer = <ADJUST>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_minus {
            timeout-ms = <100>;
            key-positions = <6 7>;
            bindings = <&kp MINUS>;
        };
        combo_equal {
            timeout-ms = <100>;
            key-positions = <16 17>;
            bindings = <&kp EQUAL>;
        };
        combo_quote {
            timeout-ms = <100>;
            key-positions = <12 13>;
            bindings = <&kp SQT>;
        };
        combo_plus {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp PLUS>;
        };
        combo_tmux {
            timeout-ms = <200>;
            key-positions = <15 32>;
            bindings = <&kp LC(B)>;
        };
        combo_bkspace {
            timeout-ms = <100>;
            key-positions = <18 19>;
            bindings = <&kp BSPC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q        &kp W      &kp E        &kp R      &kp T         &kp Y      &kp U      &kp I        &kp O       &kp P
                &hm LALT A   &hm LCTRL S &hm LSHIFT D &hm LGUI F &kp G         &kp H      &hm RGUI J &hm RSHIFT K &hm RCTRL L &hm RALT SEMICOLON
                &kp Z        &kp X      &kp C        &kp V      &kp B         &kp N      &kp M      &kp COMMA    &kp DOT     &kp FSLH
                                           &lt NAV SPACE &lt LOWER ENTER       &lt LOWER ESC &lt NAV BSPC
            >;
        };

        lower_layer {
            bindings = <
                &trans       &trans     &trans       &kp F11    &kp F12       &kp GRAVE  &trans     &trans       &kp LBKT   &kp RBKT
                &hm LALT F10 &hm LCTRL F9 &hm LSHIFT F8 &hm LGUI F7 &kp F6   &kp N1     &hm RGUI N2 &hm RSHIFT N3 &hm RCTRL N4 &hm RALT N5
                &kp F5       &kp F4     &kp F3       &kp F2     &kp F1        &kp N6     &kp N7     &kp N8       &kp N9     &kp N0
                                              &kp SPACE &kp ENTER             &kp APOSTROPHE &kp NON_US_BSLH
            >;
        };

        nav_layer {
            bindings = <
                &bootloader  &bootloader &sys_reset   &trans     &trans        &kp HOME   &kp END    &kp C_VOL_UP &kp LS(LC(TAB)) &trans
                &trans       &trans      &trans       &trans     &trans        &kp PRINTSCREEN   &kp CARET  &kp DLLR     &kp C_VOL_DN  &kp LC(TAB)
                &trans       &trans      &trans       &trans     &trans        &kp LEFT   &kp DOWN   &kp UP       &kp RIGHT     &trans
                                              &trans     &trans                &trans     &trans
            >;
        };

        adjust_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_CLR     &trans       &trans      &bootloader   &trans     &trans     &trans       &trans       &bootloader
                &bt BT_SEL 1 &bt BT_NXT     &trans       &trans      &trans        &trans     &trans     &trans       &trans       &trans
                &bt BT_SEL 2 &bt BT_CLR_ALL &trans       &trans      &trans        &trans     &trans     &trans       &trans       &trans
                                              &trans     &trans                &trans     &trans
            >;
        };
    };
};
